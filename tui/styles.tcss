Screen {
    layout: vertical;
    background: #1a1a1a;
}

/* Splash Screen Styles */
#splash-container {
    align: center middle;
    height: 100%;
    content-align: center middle;
    background: #1a1a1a;
}

#logo {
    color: #ffd600; /* Richer Yellow */
    text-align: center;
    margin-bottom: 2;
}

#boot_log {
    text-align: center;
    color: #ffd600;
    text-style: bold;
}

/* Dashboard Grid Layout */
/* Local Dashboard Grid Layout */
LocalDashboard {
    layout: grid;
    grid-size: 2 3; 
    grid-columns: 30% 1fr;
    grid-rows: 15% 55% 30%;
    background: #1a1a1a;
    grid-gutter: 1; /* Add space between grid items */
    padding: 1;
}

/* Widget Styles */
#system-metrics {
    column-span: 2;
    border: round #ffd600; 
    background: #252525;
    color: #e0e0e0;
    padding: 0 1;
    layout: horizontal;
    height: 100%;
    margin-bottom: 1;
}

/* Apply width to the Widget classes themselves */
#cpu-display, #ram-display, #disk-display, #net-display {
    width: 1fr;
    height: 100%;
    align: center middle;
    padding: 1;
}

#system-metrics .metric-label {
    text-align: center;
    color: #ff5252;
    text-style: bold;
    width: 100%;
    padding-bottom: 1;
}

#sidebar-container {
    row-span: 2;
    border: round #ffd600; 
    background: #252525;
    overflow-y: hidden;
    margin-right: 1;
}

#alerts-panel {
    height: 30%;
    border-bottom: solid #444; /* Subtle separator */
    padding: 1;
}

#alerts-header {
    width: 100%;
    text-align: center;
    background: #d32f2f; /* Darker Red */
    color: white;
    text-style: bold;
    margin-bottom: 1;
}

#file-browser {
    height: 70%;
    background: #1e1e1e;
    border-top: none;
    padding: 1;
}

#terminal-area {
    border: round #ffd600;
    background: #0d0d0d;
    padding: 1;
    margin-bottom: 1;
}

#term-output {
    height: 1fr;
    border: none;
    background: #0d0d0d;
    padding: 1;
    color: #4caf50; /* Softer Terminal Green */
}

#term-input {
    dock: bottom;
    border: solid #ffd600;
    background: #0d0d0d;
    color: #ffd600;
}

#process-panel {
    border: round #ffd600;
    background: #252525;
}

DataTable {
    background: #252525;
    color: #e0e0e0;
}

/* Explicit Metrics Visibility Styles */
ProgressBar {
    width: 100%;
    height: 1;
    margin: 1 0;
}

Bar > .bar--bar {
    color: #ffd600;
    background: #444444;
}

Bar > .bar--complete {
    color: #ff5252;
}

Sparkline {
    width: 100%;
    height: 3;
    color: #69f0ae; /* Soft Green */
    background: #252525;
}

Sparkline > .sparkline--min {
    color: #555555;
}

Sparkline > .sparkline--max {
    color: #ff5252;
}

/* Production Mode Styles */
#prod-content {
    height: 1fr;
}
#prod-list-area {
    width: 70%;
    border-right: solid #444;
    padding: 1;
}
#prod-details {
    width: 30%;
    padding: 1;
}
#prod-actions {
    height: auto;
    margin-top: 1;
}

/* Testing Mode Styles */
#test-output {
    height: 1fr;
    border: round #6272a4;
    background: #1a1a1a;
    margin-top: 1;
}

.test-box {
    width: 50%;
    border: round #ffd600;
    padding: 1;
}

/* Settings Styles */
#settings-form {
    width: 50%;
    align: center middle; 
}
#settings-form Input {
    margin-bottom: 1;
}
